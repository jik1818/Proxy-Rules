#====拦截规则====

# 全球主流 CA 机构 OCSP 明文泄露防追踪规则（本地 REJECT 触发 Soft Fail）
# --------------------------------------------------

# Google Trust Services
DOMAIN-SUFFIX, ocsp.pki.goog, REJECT

# DigiCert / Symantec / GeoTrust / Thawte / RapidSSL
DOMAIN-SUFFIX, ocsp.digicert.com, REJECT
DOMAIN-SUFFIX, ocsp.digicert.cn, REJECT
DOMAIN-SUFFIX, ocsp.geotrust.com, REJECT
DOMAIN-SUFFIX, ocsp.thawte.com, REJECT
DOMAIN-SUFFIX, ocsp.rapidssl.com, REJECT

